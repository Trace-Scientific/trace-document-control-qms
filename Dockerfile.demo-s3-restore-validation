FROM node:22-bookworm-slim AS app-build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npx prisma generate
RUN npm run build

FROM postgres:18-bookworm
USER root
RUN apt-get update && apt-get install -y --no-install-recommends awscli ca-certificates coreutils libstdc++6 openssl && rm -rf /var/lib/apt/lists/*
COPY --from=app-build /usr/local/bin/node /usr/local/bin/node
COPY --from=app-build --chown=postgres:postgres /app/.next/standalone /opt/trace-qms
COPY --from=app-build --chown=postgres:postgres /app/.next/static /opt/trace-qms/.next/static
COPY --chmod=0755 scripts/railway-demo-s3-restore-validation.sh /usr/local/bin/validate-demo-restore
USER postgres
ENTRYPOINT ["/usr/local/bin/validate-demo-restore"]
