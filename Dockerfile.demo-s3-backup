# Dedicated demo-only PostgreSQL logical backup worker. Not used by the web app.
FROM postgres:18-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends awscli ca-certificates coreutils \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 scripts/railway-demo-s3-backup.sh /usr/local/bin/demo-s3-backup
USER postgres
ENTRYPOINT ["/usr/local/bin/demo-s3-backup"]
