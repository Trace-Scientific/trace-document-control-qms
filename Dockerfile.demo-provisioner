# One-shot, read-only demo provisioning plan. Never use as a web application.
FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY prisma ./prisma
RUN npx prisma generate

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 qms && adduser --system --uid 1001 --ingroup qms qms
COPY --from=builder --chown=qms:qms /app/node_modules ./node_modules
COPY --from=builder --chown=qms:qms /app/prisma ./prisma
COPY --chown=qms:qms scripts/railway-demo-identity.mjs scripts/railway-demo-runtime.mjs scripts/railway-demo-db-preflight.mjs scripts/railway-demo-provisioner-role-gate.mjs scripts/railway-demo-provisioning-plan.mjs ./scripts/
USER qms
# This entrypoint rejects all arguments and never applies writes.
CMD ["node", "scripts/railway-demo-provisioning-plan.mjs"]
